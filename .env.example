# 从 https://platform.openai.com/api-keys 创建密钥。
# 不要把真实密钥提交到版本控制。
OPENAI_API_KEY=sk-your-key-here

# 适合交互式生成的质量/成本平衡档；也可以通过环境变量替换。
OPENAI_MODEL=gpt-5.6-terra

# 公开站点总开关。设为 false 后网页仍可玩，但所有 AI 生成改用本地规则，不再消耗 API。
ROUGEHATE_AI_ENABLED=true

# 仅用于 Docker/Caddy 自托管；必须换成你拥有 DNS 权限的域名。
ROUGEHATE_DOMAIN=game.example.com

# 每个访客 IP 在窗口期内最多发起多少次生成请求。
ROUGEHATE_RATE_LIMIT=12
ROUGEHATE_RATE_WINDOW_SECONDS=60

# 可选：修改监听地址与端口。
ROUGEHATE_HOST=127.0.0.1
ROUGEHATE_PORT=8787

# 只有后端确定只接受可信反向代理流量时才开启；compose.yaml 会在容器内开启。
ROUGEHATE_TRUST_PROXY=false
